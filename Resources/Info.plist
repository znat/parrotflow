<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>ParrotFlow</string>
	<key>CFBundleDisplayName</key>
	<string>ParrotFlow</string>
	<key>CFBundleExecutable</key>
	<string>ParrotFlow</string>
	<key>CFBundleIdentifier</key>
	<string>com.parrotflow.app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Both versions are rewritten by release-please on the release PR; the
	     annotation is what it looks for, so keep it on the same line. -->
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string> <!-- x-release-please-version -->
	<key>CFBundleVersion</key>
	<string>0.1.0</string> <!-- x-release-please-version -->
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>

	<!-- Menu bar only: no Dock icon, no ⌘-Tab entry. -->
	<key>LSUIElement</key>
	<true/>

	<!-- Without this key macOS terminates the process instead of prompting. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>ParrotFlow records your voice so it can be transcribed on this Mac. Audio is never uploaded anywhere.</string>
</dict>
</plist>
